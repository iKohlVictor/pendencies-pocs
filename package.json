{
  "name": "pendencies-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter machine-flow build && pnpm -r typecheck",
    "test": "pnpm --filter machine-flow build && pnpm -r test",
    "dev": "pnpm --filter machine-flow build && pnpm --filter api start:dev",
    "dev:web": "pnpm --filter web start"
  }
}
